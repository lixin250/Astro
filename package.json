{
  "name": "lixin-dev",
  "private": true,
  "workspaces": [
    "tools",
    "videos",
    "resume"
  ],
  "scripts": {
    "tools:dev": "npm run dev -w tools",
    "tools:build": "npm run build -w tools",
    "tools:build:cf": "npm install && npm run tools:build",

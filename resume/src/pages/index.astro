---
import ResumeLayout from '../layouts/ResumeLayout.astro';
import { resume } from '../data/resume';
import { linkify } from '../lib/linkify';
import '../styles/resume.css';

const pageTitle = `${resume.name} · ${resume.title}`;
const pdfName = '利欣-unity客户端-7年.pdf';
const links = resume.keywordLinks;
const timelineJobs = [...resume.experience].reverse();
---

<ResumeLayout title={pageTitle} description={`${resume.name} · ${resume.title} · ${resume.intent.map((i) => i.value).join(' · ')}`}>
  <div class="page">
    <div class="toolbar" data-toolbar>
      <button type="button" class="btn" id="export-pdf" data-pdf-name={pdfName}>
        导出 PDF
      </button>
      <button type="button" class="btn btn-ghost" id="print-resume">
        打印
      </button>
    </div>

    <article class="resume" id="resume">
      <header class="hero">
        <div class="hero-main">
          <div class="hero-text">
            <h1 class="brand">{resume.name}</h1>
            <p class="basics">{resume.basics.join('  ·  ')}</p>
            <ul class="meta">
              <li>
                <button
                  type="button"
                  class="meta-copy"
                  data-copy={resume.phone}
                  data-copy-label="电话 / 微信"
                  title="点击复制"
                  aria-label={`电话与微信 ${resume.phone}，点击复制`}
                >
                  <span class="meta-icons" aria-hidden="true">
                    <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.3 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C11.4 21 3 12.6 3 2c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1L6.6 10.8Z" />
                    </svg>
                    <svg class="meta-icon meta-icon-wechat" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M9.5 4C5.9 4 3 6.5 3 9.6c0 1.8.9 3.4 2.4 4.5l-.6 2.2 2.4-1.3c.7.2 1.5.3 2.3.3.2 0 .5 0 .7-.1-.1-.4-.2-.9-.2-1.3 0-3.1 2.8-5.6 6.3-5.6.2 0 .4 0 .6 0C16.3 5.7 13.2 4 9.5 4Zm-2.2 3.2c.5 0 .9.4.9.9s-.4.9-.9.9-.9-.4-.9-.9.4-.9.9-.9Zm4.1 0c.5 0 .9.4.9.9s-.4.9-.9.9-.9-.4-.9-.9.4-.9.9-.9Zm9.6 3.2c-2.9 0-5.2 2-5.2 4.5s2.3 4.5 5.2 4.5c.5 0 1.1-.1 1.6-.2l1.8 1-.5-1.7c1.1-.9 1.8-2.1 1.8-3.6 0-2.5-2.3-4.5-5.2-4.5Zm-1.8 3.2c-.3 0-.6-.3-.6-.6s.3-.6.6-.6.6.3.6.6-.3.6-.6.6Zm3.5 0c-.3 0-.6-.3-.6-.6s.3-.6.6-.6.6.3.6.6-.3.6-.6.6Z" />
                    </svg>
                  </span>
                  <span>{resume.phone}</span>
                </button>
              </li>
              <li>
                <button
                  type="button"
                  class="meta-copy"
                  data-copy={resume.email}
                  data-copy-label="邮箱"
                  title="点击复制"
                  aria-label={`邮箱 ${resume.email}，点击复制`}
                >
                  <span class="meta-icons" aria-hidden="true">
                    <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                      <rect x="3" y="5" width="18" height="14" rx="2" />
                      <path d="m3 7 9 7 9-7" />
                    </svg>
                  </span>
                  <span>{resume.email}</span>
                </button>
              </li>
            </ul>
            <p class="meta-toast" id="meta-toast" hidden></p>
            <ul class="intent">
              {resume.intent.map((item) => (
                <li>
                  <span>{item.label}</span>
                  <strong>{item.value}</strong>
                </li>
              ))}
            </ul>
          </div>
          <img
            class="avatar"
            id="resume-avatar"
            src={resume.avatarPreview}
            data-preview={resume.avatarPreview}
            data-export={resume.avatarExport}
            alt={`${resume.name} 头像`}
            width="128"
            height="128"
          />
        </div>
      </header>

      <section class="section">
        <h2>教育经历</h2>
        {resume.education.map((edu) => (
          <div class="entry">
            <div class="entry-head">
              <div>
                <h3>{edu.school}</h3>
                <p class="role">{edu.degree}</p>
              </div>
              <p class="period">{edu.period}</p>
            </div>
          </div>
        ))}
      </section>

      <section class="section">
        <h2>专业技能</h2>
        <ul class="skill-core">
          {resume.skills.map((skill) => (
            <li>
              <strong>{skill}</strong>
            </li>
          ))}
        </ul>
      </section>

      <section class="section">
        <h2>工作经历</h2>
        {timelineJobs.map((job) => (
          <div class="entry">
            <div class="entry-head">
              <div>
                <h3>{job.company}</h3>
                <p class="role">{job.role}</p>
              </div>
              <p class="period">{job.period}</p>
            </div>
            {job.overview ? <p class="project-desc" set:html={linkify(job.overview, links)} /> : null}
            {job.highlights.length > 0 ? (
              <ol class="bullets numbered">
                {job.highlights.map((line) => (
                  <li set:html={linkify(line, links)} />
                ))}
              </ol>
            ) : null}
            {job.achievements.length > 0 ? (
              <>
                <p class="subhead">业绩</p>
                <ul class="bullets">
                  {job.achievements.map((line) => (
                    <li set:html={linkify(line, links)} />
                  ))}
                </ul>
              </>
            ) : null}

            {job.projects.map((project) => {
              const diagrams = project.diagrams ?? [];
              const highlights = project.highlights ?? [];
              const achievements = project.achievements ?? [];
              return (
                <div class="project-block">
                  <div class="project-head">
                    <div>
                      <h4 class="project-name">{project.name}</h4>
                    </div>
                    {'period' in project && project.period ? (
                      <p class="period">{project.period}</p>
                    ) : null}
                  </div>
                  {project.overview ? (
                    <p class="project-desc" set:html={linkify(project.overview, links)} />
                  ) : null}
                  {highlights.length > 0 ? (
                    <>
                      <p class="subhead">工作内容</p>
                      <ul class="bullets">
                        {highlights.map((line) => (
                          <li set:html={linkify(line, links)} />
                        ))}
                      </ul>
                    </>
                  ) : null}
                  {achievements.length > 0 ? (
                    <>
                      <p class="subhead">成长轨迹</p>
                      <ul class="bullets">
                        {achievements.map((line) => (
                          <li set:html={linkify(line, links)} />
                        ))}
                      </ul>
                    </>
                  ) : null}
                  {diagrams.length > 0 ? (
                    <div class="diagrams">
                      <p class="subhead">相关链接</p>
                      <ul class="diagram-list">
                        {diagrams.map((diagram) => (
                          <li class="diagram-item extras-link-item">
                            {diagram.url ? (
                              <a
                                class="diagram-link"
                                href={diagram.url}
                                target="_blank"
                                rel="noopener noreferrer"
                              >
                                {diagram.title}
                                <span class="diagram-open">打开</span>
                              </a>
                            ) : (
                              <span class="diagram-text">{diagram.title}</span>
                            )}
                            {diagram.note ? <span class="extras-note">{diagram.note}</span> : null}
                          </li>
                        ))}
                      </ul>
                    </div>
                  ) : null}
                </div>
              );
            })}
          </div>
        ))}
      </section>

      <section class="section">
        <h2>其他技能</h2>
        {resume.otherSkills.tags.length > 0 ? (
          <ul class="skill-tags">
            {resume.otherSkills.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        ) : null}
        {resume.otherSkills.notes?.length ? (
          <ul class="bullets">
            {resume.otherSkills.notes.map((line) => (
              <li set:html={linkify(line, links)} />
            ))}
          </ul>
        ) : null}
        {resume.otherSkills.links.length > 0 ? (
          <ul class="diagram-list extras-links">
            {resume.otherSkills.links.map((item) => (
              <li class="diagram-item extras-link-item">
                <a
                  class="diagram-link"
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {item.title}
                  <span class="diagram-open">打开</span>
                </a>
                {item.note ? <span class="extras-note">{item.note}</span> : null}
              </li>
            ))}
          </ul>
        ) : null}
      </section>

      <p class="online-tip">
        在线简历（可点击跳转详情 / 链接）：
        <a href="https://resume.lixin.dev" target="_blank" rel="noopener noreferrer">https://resume.lixin.dev</a>
      </p>
    </article>
  </div>
</ResumeLayout>

<script>
  const exportBtn = document.getElementById('export-pdf');
  const printBtn = document.getElementById('print-resume');
  const resumeEl = document.getElementById('resume');
  const avatarImg = document.getElementById('resume-avatar');
  const metaToast = document.getElementById('meta-toast');

  async function copyText(text: string) {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text);
      return;
    }
    const input = document.createElement('textarea');
    input.value = text;
    input.setAttribute('readonly', '');
    input.style.position = 'fixed';
    input.style.left = '-9999px';
    document.body.appendChild(input);
    input.select();
    document.execCommand('copy');
    document.body.removeChild(input);
  }

  function showMetaToast(message: string) {
    if (!(metaToast instanceof HTMLElement)) return;
    metaToast.hidden = false;
    metaToast.textContent = message;
    window.setTimeout(() => {
      metaToast.hidden = true;
    }, 1800);
  }

  document.querySelectorAll<HTMLElement>('.meta-copy[data-copy]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const value = btn.getAttribute('data-copy') || '';
      const label = btn.getAttribute('data-copy-label') || '内容';
      if (!value) return;
      void copyText(value).then(() => showMetaToast(`已复制${label}：${value}`));
    });
  });

  function setExportBusy(busy: boolean) {
    if (!(exportBtn instanceof HTMLButtonElement)) return;
    exportBtn.disabled = busy;
    exportBtn.textContent = busy ? '导出中…' : '导出 PDF';
  }

  function waitForImage(img: HTMLImageElement, timeoutMs = 8000) {
    if (img.complete && img.naturalWidth > 0) return Promise.resolve();
    return new Promise<void>((resolve, reject) => {
      const timer = window.setTimeout(() => {
        cleanup();
        reject(new Error('头像加载超时'));
      }, timeoutMs);
      const onLoad = () => {
        cleanup();
        resolve();
      };
      const onError = () => {
        cleanup();
        reject(new Error('头像加载失败'));
      };
      const cleanup = () => {
        window.clearTimeout(timer);
        img.removeEventListener('load', onLoad);
        img.removeEventListener('error', onError);
      };
      img.addEventListener('load', onLoad);
      img.addEventListener('error', onError);
    });
  }

  async function withExportAvatar<T>(run: () => Promise<T>): Promise<T> {
    if (!(avatarImg instanceof HTMLImageElement)) return run();

    const previewSrc = avatarImg.getAttribute('data-preview') || avatarImg.src;
    const exportSrc = avatarImg.getAttribute('data-export') || avatarImg.src;
    const previousSrc = avatarImg.getAttribute('src') || previewSrc;

    // 导出时锁尺寸；实际右上角定位交给 .is-exporting 绝对定位
    avatarImg.style.width = '96px';
    avatarImg.style.height = '96px';
    avatarImg.style.objectFit = 'cover';
    avatarImg.style.objectPosition = 'center top';
    avatarImg.src = exportSrc;
    try {
      try {
        await waitForImage(avatarImg);
      } catch (error) {
        console.warn(error);
        // 头像失败不阻断导出
      }
      if (document.fonts?.ready) {
        try {
          await document.fonts.ready;
        } catch {
          // ignore
        }
      }
      await new Promise<void>((resolve) => requestAnimationFrame(() => requestAnimationFrame(() => resolve())));
      return await run();
    } finally {
      avatarImg.src = previousSrc === exportSrc ? previewSrc : previousSrc;
      avatarImg.style.width = '';
      avatarImg.style.height = '';
      avatarImg.style.objectFit = '';
      avatarImg.style.objectPosition = '';
    }
  }

  function triggerBlobDownload(blob: Blob, filename: string) {
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = filename;
    link.rel = 'noopener';
    link.style.display = 'none';
    document.body.appendChild(link);
    link.click();
    link.remove();
    window.setTimeout(() => URL.revokeObjectURL(url), 2000);
  }

  async function downloadPdf() {
    if (!(resumeEl instanceof HTMLElement) || !(exportBtn instanceof HTMLButtonElement)) return;

    const rawName = exportBtn.getAttribute('data-pdf-name') || '利欣-unity客户端-7年.pdf';
    const filename = /\.pdf$/i.test(rawName) ? rawName.replace(/[\\/:*?"<>|]+/g, '_') : '利欣-unity客户端-7年.pdf';

    setExportBusy(true);

    try {
      await withExportAvatar(async () => {
        const [{ default: html2canvas }, { jsPDF }] = await Promise.all([
          import('html2canvas'),
          import('jspdf'),
        ]);

        resumeEl.classList.add('is-exporting');
        try {
          if (document.fonts?.ready) {
            try {
              await document.fonts.ready;
            } catch {
              // ignore
            }
          }
          // 等样式切到系统中文字体后再截图
          await new Promise<void>((resolve) => requestAnimationFrame(() => requestAnimationFrame(() => resolve())));

          // html2canvas 会克隆 DOM 并重跑 CSS 动画；
          // 西文 Web 字体不含中文时，抬头/公司名常被画丢
          const canvas = await html2canvas(resumeEl, {
            scale: 2,
            useCORS: true,
            allowTaint: true,
            backgroundColor: '#ffffff',
            logging: false,
            imageTimeout: 5000,
            windowWidth: 794,
            ignoreElements: (element) => element.classList?.contains('no-export') === true,
            onclone(clonedDoc) {
              // 去掉 Google Fonts，避免克隆文档仍优先用无中文的 Syne/DM Sans
              clonedDoc
                .querySelectorAll('link[href*="fonts.googleapis"], link[href*="fonts.gstatic"]')
                .forEach((node) => node.remove());

              const forceFont =
                '"Microsoft YaHei", "SimHei", "PingFang SC", "Noto Sans SC", sans-serif';
              const style = clonedDoc.createElement('style');
              style.textContent = `
                #resume, #resume * {
                  font-family: ${forceFont} !important;
                  animation: none !important;
                  animation-delay: 0s !important;
                  opacity: 1 !important;
                  transform: none !important;
                  visibility: visible !important;
                }
                #resume { color: #0b1220 !important; background: #fff !important; }
                #resume .brand,
                #resume h1, #resume h2, #resume h3, #resume h4,
                #resume .subhead, #resume .project-name {
                  color: #0b1220 !important;
                }
                #resume .section h2 { text-transform: none !important; }
              `;
              clonedDoc.head?.appendChild(style);

              const clonedResume = clonedDoc.getElementById('resume');
              if (clonedResume instanceof HTMLElement) {
                clonedResume.classList.add('is-exporting');
                clonedResume.style.width = '794px';
                clonedResume.style.maxWidth = '794px';
                clonedResume.style.overflow = 'visible';
                clonedResume.style.fontFamily = forceFont;
                clonedResume.style.color = '#0b1220';
                clonedResume.style.background = '#ffffff';
              }

              // button 在部分浏览器 html2canvas 下文字易丢，改成 span
              clonedDoc.querySelectorAll('#resume button').forEach((btn) => {
                if (!(btn instanceof HTMLElement)) return;
                const span = clonedDoc.createElement('span');
                span.textContent = (btn.textContent || '').trim();
                span.className = btn.className;
                span.style.fontFamily = forceFont;
                span.style.color = '#243044';
                btn.replaceWith(span);
              });

              const clonedBrand = clonedDoc.querySelector('.brand');
              if (clonedBrand instanceof HTMLElement) {
                clonedBrand.style.fontFamily = forceFont;
                clonedBrand.style.fontWeight = '800';
                clonedBrand.style.color = '#0b1220';
                clonedBrand.style.letterSpacing = '0.02em';
              }

              clonedDoc.querySelectorAll('#resume h2, #resume h3, #resume h4').forEach((node) => {
                if (!(node instanceof HTMLElement)) return;
                node.style.fontFamily = forceFont;
                node.style.color = '#0b1220';
                node.style.opacity = '1';
              });

              const clonedAvatar = clonedDoc.getElementById('resume-avatar');
              if (clonedAvatar instanceof HTMLImageElement) {
                clonedAvatar.style.position = 'absolute';
                clonedAvatar.style.top = '0';
                clonedAvatar.style.right = '0';
                clonedAvatar.style.left = 'auto';
                clonedAvatar.style.bottom = 'auto';
                clonedAvatar.style.margin = '0';
                clonedAvatar.style.width = '96px';
                clonedAvatar.style.height = '96px';
                clonedAvatar.style.objectFit = 'cover';
                clonedAvatar.style.objectPosition = 'center top';
              }
              const clonedHero = clonedDoc.querySelector('.hero');
              if (clonedHero instanceof HTMLElement) {
                clonedHero.style.position = 'relative';
              }
              const clonedHeroText = clonedDoc.querySelector('.hero-text');
              if (clonedHeroText instanceof HTMLElement) {
                clonedHeroText.style.paddingRight = '112px';
                clonedHeroText.style.paddingTop = '0';
              }
              clonedDoc.querySelectorAll('.no-export').forEach((node) => {
                if (node instanceof HTMLElement) node.style.display = 'none';
              });
            },
          });

          if (!canvas.width || !canvas.height) {
            throw new Error('页面截图失败');
          }

          const pdf = new jsPDF({
            orientation: 'portrait',
            unit: 'mm',
            format: 'a4',
            compress: true,
          });

          // 按 A4 内容宽铺满，超出高度自动分页裁切
          const pageWidth = pdf.internal.pageSize.getWidth();
          const pageHeight = pdf.internal.pageSize.getHeight();
          const margin = 10;
          const contentWidth = pageWidth - margin * 2;
          const contentHeight = pageHeight - margin * 2;
          const imgHeightMm = (canvas.height * contentWidth) / canvas.width;
          const pageCount = Math.max(1, Math.ceil(imgHeightMm / contentHeight));
          const slicePx = Math.floor((contentHeight / imgHeightMm) * canvas.height);

          for (let i = 0; i < pageCount; i++) {
            const srcY = i * slicePx;
            const srcH = Math.min(slicePx, canvas.height - srcY);
            if (srcH <= 0) break;

            const pageCanvas = document.createElement('canvas');
            pageCanvas.width = canvas.width;
            pageCanvas.height = srcH;
            const ctx = pageCanvas.getContext('2d');
            if (!ctx) throw new Error('分页画布创建失败');
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, pageCanvas.width, pageCanvas.height);
            ctx.drawImage(canvas, 0, srcY, canvas.width, srcH, 0, 0, canvas.width, srcH);

            const sliceH = (srcH * contentWidth) / canvas.width;
            if (i > 0) pdf.addPage();
            pdf.addImage(
              pageCanvas.toDataURL('image/jpeg', 0.92),
              'JPEG',
              margin,
              margin,
              contentWidth,
              sliceH,
            );
          }

          const blob = pdf.output('blob');
          if (!(blob instanceof Blob) || blob.size < 100) {
            throw new Error('PDF 生成失败');
          }

          triggerBlobDownload(blob, filename);
        } finally {
          resumeEl.classList.remove('is-exporting');
        }
      });
    } catch (error) {
      console.error(error);
      alert(`导出 PDF 失败：${error instanceof Error ? error.message : '未知错误'}。可改用「打印」。`);
    } finally {
      setExportBusy(false);
    }
  }

  exportBtn?.addEventListener('click', () => {
    void downloadPdf();
  });

  printBtn?.addEventListener('click', () => {
    void withExportAvatar(async () => {
      window.print();
    });
  });
</script>
